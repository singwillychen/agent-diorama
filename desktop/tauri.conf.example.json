{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Diorama",
  "identifier": "dev.agent-diorama.app",
  "version": "0.1.0",
  "build": {
    "frontendDist": "../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run web",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      { "title": "Agent Diorama", "width": 1440, "height": 900, "minWidth": 960, "minHeight": 600, "transparent": false }
    ],
    "security": { "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:4319; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com" }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "msi", "appimage"],
    "externalBin": ["binaries/diorama-hub"]
  }
}
